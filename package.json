{
  "name": "eazylyst",
  "version": "1.0.3",
  "description": "List maker software with drag-and-drop categorization",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "test": "node test-categorization.js"
  },
  "keywords": [
    "electron",
    "list",
    "categorization"
  ],
  "author": "DanPolland8",
  "license": "ISC",
  "devDependencies": {
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.eazylyst.app",
    "productName": "EazyLyst",
    "icon": "build/icons/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "DanPolland8",
        "repo": "EazyLyst",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "build/icons/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "electron-updater": "^6.8.3"
  }
}
