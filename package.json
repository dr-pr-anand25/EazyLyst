{
  "name": "eazylyst",
  "version": "1.0.2",
  "description": "List maker software with drag-and-drop categorization",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "test": "node test-categorization.js"
  },
  "keywords": [
    "electron",
    "list",
    "categorization"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.eazylyst.app",
    "productName": "EazyLyst",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3"
  }
}
